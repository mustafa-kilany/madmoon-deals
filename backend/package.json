{
  "name": "sahla-backend",
  "version": "1.0.0",
  "description": "Sahla API (docs/API.md)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:restore-test": "tsx scripts/restore-test.ts",
    "check:attack": "tsx scripts/attack-check.ts",
    "check:secrets": "tsx scripts/secret-scan.ts",
    "check:mutations": "tsx scripts/mutation-check.ts",
    "load-test": "tsx scripts/load-test.ts",
    "balancer-test": "tsx scripts/balancer-test.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "store": "tsx scripts/store.ts",
    "test:api": "tsx scripts/test-api.ts",
    "db:seed": "tsx scripts/seed.ts",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\"",
    "postdb:migrate": "prisma generate",
    "load-check": "tsx scripts/load-check.ts",
    "staff": "tsx scripts/staff.ts",
    "money:check": "tsx scripts/money-check.ts",
    "check:storage": "tsx scripts/storage-check.ts",
    "push:test": "tsx scripts/push-test.ts",
    "balancer-test:hosted": "tsx scripts/balancer-test-hosted.ts"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws4fetch": "1.0.20",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
