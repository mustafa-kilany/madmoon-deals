{
  "name": "sahla-backend",
  "version": "1.0.0",
  "description": "Sahla API (docs/API.md)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "store": "tsx scripts/store.ts",
    "test:api": "tsx scripts/test-api.ts",
    "db:seed": "tsx scripts/seed.ts",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\"",
    "postdb:migrate": "prisma generate",
    "load-check": "tsx scripts/load-check.ts",
    "staff": "tsx scripts/staff.ts"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
