# Copy this file to .env and fill in your values. .env is never committed.

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# USER is "postgres"; PASSWORD is the one you chose in the PostgreSQL installer.
# Symbols in the password are URL-encoded: $ → %24, @ → %40, # → %23, / → %2F, : → %3A, % → %25
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sahla"

PORT=4000

# Signs log-in tokens (JWT). Make one with `npm run secret`. Every server
# (and production) gets its own; changing it signs everyone out.
JWT_SECRET=
# How long a log-in lasts (docs/API.md: 30–90 days)
SESSION_DAYS=60
# Local testing only: this code works for any email and no email is sent.
# Leave it out in production (the server refuses to start with it there).
DEV_EMAIL_CODE=123456

# Staff (couriers, admins) use emails at this domain; public sign-up refuses it.
STAFF_EMAIL_DOMAIN=sahla.jo

# Optional: leave empty until you switch the feature on.
# Certificate OCR (backend/docs/OCR.md → Setting up Google Vision)
GOOGLE_VISION_API_KEY=
# AI summaries in the suspicious-account queue (backend/docs/ACCOUNT-RISK.md)
ANTHROPIC_API_KEY=
